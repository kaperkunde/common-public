{
  "name": "@kaperkunde/hasura",
  "version": "0.0.0",
  "description": "Hasura for Kaperkunde's apps: signed JWTs, the server and user clients, the GraphQL courier and schema index, hook helpers, and the kk-hasura CLI that renders packages' SQL and metadata templates into an app.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaperkunde/common-public.git",
    "directory": "packages/hasura"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "kk-hasura": "./dist/cli.mjs"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./sync": {
      "types": "./dist/sync.d.mts",
      "import": "./dist/sync.mjs",
      "default": "./dist/sync.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/server.ts src/client.ts src/sync.ts src/cli.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@apollo/client": "^3.13.0",
    "graphql": "^16.10.0",
    "graphql-ws": "^6.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "graphql-ws": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/client": "3.13.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "graphql": "16.10.0",
    "graphql-ws": "6.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
