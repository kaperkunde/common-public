table:
  name: {{prefix}}model_price_kinds
  schema: {{schema}}
configuration:
  comment: "What one kind of usage costs under a price, in US dollars per million units."
select_permissions:
  - role: {{server_role}}
    permission:
      columns:
        - kind
        - priceId
        - unit
        - usdPerMillion
      filter: {}
      allow_aggregations: true
    comment: The server reads everything here.
  - role: {{user_role}}
    permission:
      columns:
        - kind
        - priceId
        - unit
        - usdPerMillion
      filter: {}
    comment: "Prices are public to a signed-in user, for the screens. No AI role reads this."
