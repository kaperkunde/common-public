table:
  name: {{table_model_price_kinds}}
  schema: {{schema}}
configuration:
  comment: "What one kind of usage costs under a price, in US dollars per million units; derived kinds were worked out from a fallback when the price was set."
select_permissions:
  - role: {{server_role}}
    permission:
      columns:
        - derived
        - kind
        - priceId
        - unit
        - usdPerMillion
      filter: {}
      allow_aggregations: true
    comment: The server reads everything here.
  - role: {{user_role}}
    permission:
      columns:
        - derived
        - kind
        - priceId
        - unit
        - usdPerMillion
      filter: {}
    comment: "Prices are public to a signed-in user, for the screens. No AI role reads this."
