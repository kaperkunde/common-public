{
  "name": "@kaperkunde/credits",
  "version": "0.0.0",
  "description": "Usage credits for Kaperkunde's apps: a priced usage ledger, balances, a monthly free pool funded in dollars, admin grants, Stripe purchases and auto-refill, and a user's own model key, as Hasura/Postgres templates with the same rules in TypeScript.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaperkunde/common-public.git",
    "directory": "packages/credits"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "hasura"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./stripe": {
      "types": "./dist/stripe.d.mts",
      "import": "./dist/stripe.mjs",
      "default": "./dist/stripe.mjs"
    },
    "./feeds": {
      "types": "./dist/feeds.d.mts",
      "import": "./dist/feeds.mjs",
      "default": "./dist/feeds.mjs"
    },
    "./ui": {
      "types": "./dist/ui.d.mts",
      "import": "./dist/ui.mjs",
      "default": "./dist/ui.mjs"
    },
    "./hasura/*": "./hasura/*"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kaperkunde/next-kit": "workspace:^"
  },
  "peerDependencies": {
    "@kaperkunde/ui": ">=0.2.1",
    "react": "^19.0.0",
    "stripe": ">=22.0.0"
  },
  "peerDependenciesMeta": {
    "@kaperkunde/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kaperkunde/ui": "workspace:^",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "23.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
