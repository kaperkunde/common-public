{
  "name": "@kaperkunde/legal",
  "version": "0.2.0",
  "description": "Rendering and checking the kaperkunde/legal documents a site publishes, read from @kaperkunde/legal-docs.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaperkunde/common-public.git",
    "directory": "packages/legal"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "kaperkunde-legal": "./bin/kaperkunde-legal.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs",
      "default": "./dist/react.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/server.ts src/react.tsx src/testing.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@kaperkunde/legal-docs": "^1.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@kaperkunde/legal-docs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kaperkunde/legal-docs": "link:fixtures/legal-docs",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
