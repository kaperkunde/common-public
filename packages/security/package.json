{
  "name": "@kaperkunde/security",
  "version": "0.2.1",
  "description": "Rate limits, client addresses, safe redirects, same-origin checks, constant-time compares, signed link tokens, the admin check, a secret box boot checks, and fetches that only reach public addresses for Kaperkunde's apps.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaperkunde/common-public.git",
    "directory": "packages/security"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./net": {
      "types": "./dist/net.d.mts",
      "import": "./dist/net.mjs",
      "default": "./dist/net.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/net.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "undici": "^7.29.0"
  }
}
