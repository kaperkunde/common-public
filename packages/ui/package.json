    }
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "happy-dom": "21.0.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
