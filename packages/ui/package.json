      "import": "./dist/footer.mjs",
      "default": "./dist/footer.mjs"
    },
    "./page": {
      "types": "./dist/page.d.mts",
      "import": "./dist/page.mjs",
      "default": "./dist/page.mjs"
    },
    "./base.css": "./dist/base.css",
    "./themes/*.css": "./dist/themes/*.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "next": {
