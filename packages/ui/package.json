      "types": "./dist/table.d.mts",
      "import": "./dist/table.mjs",
      "default": "./dist/table.mjs"
    },
    "./radio-group": {
      "types": "./dist/radio-group.d.mts",
      "import": "./dist/radio-group.mjs",
      "default": "./dist/radio-group.mjs"
    },
    "./submit-button": {
      "types": "./dist/submit-button.d.mts",
      "import": "./dist/submit-button.mjs",
      "default": "./dist/submit-button.mjs"
    },
    "./form-status": {
      "types": "./dist/form-status.d.mts",
      "import": "./dist/form-status.mjs",
      "default": "./dist/form-status.mjs"
    },
    "./required-fields": {
      "types": "./dist/required-fields.d.mts",
      "import": "./dist/required-fields.mjs",
      "default": "./dist/required-fields.mjs"
    },
