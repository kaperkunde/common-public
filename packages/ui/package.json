{
  "name": "@kaperkunde/ui",
  "version": "0.2.0",
  "description": "One token contract (Tailwind v4) and the primitives on it for Kaperkunde's apps: buttons, fields, cards, lists, dialogs, menus, tabs, forms that say what they still need, and each site's theme.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaperkunde/common-public.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./cn": {
      "types": "./dist/cn.d.mts",
      "import": "./dist/cn.mjs",
      "default": "./dist/cn.mjs"
    },
    "./button": {
      "types": "./dist/button.d.mts",
      "import": "./dist/button.mjs",
      "default": "./dist/button.mjs"
    },
    "./badge": {
      "types": "./dist/badge.d.mts",
      "import": "./dist/badge.mjs",
      "default": "./dist/badge.mjs"
    },
    "./card": {
      "types": "./dist/card.d.mts",
      "import": "./dist/card.mjs",
      "default": "./dist/card.mjs"
    },
    "./input": {
      "types": "./dist/input.d.mts",
      "import": "./dist/input.mjs",
      "default": "./dist/input.mjs"
    },
    "./label": {
      "types": "./dist/label.d.mts",
      "import": "./dist/label.mjs",
      "default": "./dist/label.mjs"
    },
    "./dialog": {
      "types": "./dist/dialog.d.mts",
      "import": "./dist/dialog.mjs",
      "default": "./dist/dialog.mjs"
    },
    "./disclosure": {
      "types": "./dist/disclosure.d.mts",
      "import": "./dist/disclosure.mjs",
      "default": "./dist/disclosure.mjs"
    },
    "./list": {
      "types": "./dist/list.d.mts",
      "import": "./dist/list.mjs",
      "default": "./dist/list.mjs"
    },
    "./menu": {
      "types": "./dist/menu.d.mts",
      "import": "./dist/menu.mjs",
      "default": "./dist/menu.mjs"
    },
    "./switch": {
      "types": "./dist/switch.d.mts",
      "import": "./dist/switch.mjs",
      "default": "./dist/switch.mjs"
    },
    "./segmented-control": {
      "types": "./dist/segmented-control.d.mts",
      "import": "./dist/segmented-control.mjs",
      "default": "./dist/segmented-control.mjs"
    },
    "./tabs": {
      "types": "./dist/tabs.d.mts",
      "import": "./dist/tabs.mjs",
      "default": "./dist/tabs.mjs"
